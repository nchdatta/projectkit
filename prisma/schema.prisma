// Output lives at project root (`@generated/*`), gitignored — run `npm run db:generate` after edits.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URL comes from prisma.config.ts (CLI) and the pg adapter in src/lib/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

// Reference model — the worked example for the layering contract. More CRM models land the same way.
model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String
  phone      String?
  status     LeadStatus @default(NEW)
  source     String?
  notes      String?
  deleted_at DateTime?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@index([status])
  @@index([deleted_at])
  @@map("leads")
}
