// Output lives at project root (`@generated/*`), gitignored — run `npm run db:generate` after edits.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URL comes from prisma.config.ts (CLI) and the pg adapter in src/lib/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

// Infrastructure check — CRM models (Lead, Contact, Deal, …) land here later.
model HealthCheck {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())

  @@map("health_checks")
}
