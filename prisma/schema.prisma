// Prisma 7. The `prisma-client` generator writes TypeScript into `output` —
// there is no more implicit `node_modules/.prisma` client, so the import path in
// `src/lib/db.ts` points at the generated directory (gitignored, regenerate with
// `npm run db:generate`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in `prisma.config.ts` (CLI) and in the pg adapter
// inside `src/lib/db.ts` (runtime). Prisma 7 no longer accepts `url` here.
datasource db {
  provider = "postgresql"
}

/// Infrastructure only — proves migrations and the client round-trip work.
/// CRM models (Lead, Contact, Deal, Activity, …) land here in a later pass.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
